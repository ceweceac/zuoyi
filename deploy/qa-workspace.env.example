# 复制为 qa-workspace.env 后填写。该文件包含密码，不要提交到 Git。
QA_WORKSPACE_OWNER_USERNAME=qa_owner
QA_WORKSPACE_OWNER_PASSWORD=请改成至少12位的负责人密码
QA_WORKSPACE_PARTNER_USERNAME=qa_partner
QA_WORKSPACE_PARTNER_PASSWORD=请改成至少12位的伙伴密码
# editor：只改 QA；admin：完整测试后台，可配置测试群 Webhook
QA_WORKSPACE_PARTNER_ROLE=editor
# true：开放完整测试后台；false：只开放 QA 内容页面
QA_WORKSPACE_FULL_UI=true
JWT_SECRET=请改成至少32位随机字符串
QABOT_UI_STORAGE_SECRET=请改成另一段至少32位随机字符串
